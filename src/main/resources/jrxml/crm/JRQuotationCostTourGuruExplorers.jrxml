				<text><![CDATA[•  Restante a ser pagado:]]></text>
			</staticText>
			<textField>
				<reportElement x="171" y="29" width="140" height="16" uuid="076ae61b-95a9-4baa-a181-2844b2152aa5"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["50% adelantado"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="171" y="46" width="140" height="16" uuid="47d224c7-c573-42b9-8f5e-7ae7a374ff42"/>
				<textElement>
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["7 días antes del inicio"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="22" y="95" width="488" height="16" uuid="b489dcb0-e5e6-4d62-8ae8-86184a4bd915"/>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<text><![CDATA[•  Tarjeta de crédito (+4-5 %): Visa, MasterCard o American Express Transferencias ACH (USA, +1-2%)]]></text>
			</staticText>
			<staticText>
				<reportElement x="22" y="114" width="488" height="16" uuid="73b8fab8-cab2-44f5-a64d-06b204df7631"/>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<text><![CDATA[•  Transferencia bancaria internacional: fees de envío + 25 USD (fees de banco local)]]></text>
			</staticText>
			<staticText>
				<reportElement x="21" y="131" width="488" height="16" uuid="d957f872-a428-4b70-bfb3-cee910594227"/>
				<textElement>
					<font isBold="false"/>
				</textElement>
				<text><![CDATA[•  Pago en efectivo: en oficina (sin costo extra), en hotel o fuera de horario laboral (+ 10 USD)]]></text>
			</staticText>
			<staticText>
				<reportElement x="22" y="153" width="559" height="29" uuid="97e253a1-3a6b-4eb3-ab36-4e049fcba70e"/>
				<textElement>
					<font fontName="Arial Black" size="8" isBold="false"/>
				</textElement>
				<text><![CDATA[NOTA: En caso de no haber completado el pago de los servicios separado a la fecha oportuna, se pasará a cancelar los servicios sin derecho a reclamo.]]></text>
			</staticText>
